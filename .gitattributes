# Normalise to LF in the repository.
* text=auto eol=lf

# Shell scripts must stay LF even when checked out on Windows: a CRLF shebang
# fails on Linux with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

*.py  text eol=lf
*.md  text eol=lf

# Windows-only launchers are happier with CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
